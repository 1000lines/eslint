# Convert text file line endings to lf
* text=auto

*.js text eol=lf

# The test fixtures are text files.
/tests/fixtures/**/* text eol=lf

# Collapse per-project bookkeeping; top-level requirements, designs and plans stay visible.
docs/symphony-plans/*/** linguist-generated
# Keep Mermaid diagrams visible, including diagrams inside project folders.
docs/symphony-plans/**/*.mmd -linguist-generated
